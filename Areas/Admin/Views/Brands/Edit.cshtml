@model Winery.Models.Brand

@{
    ViewData["Title"] = "Edit Brand";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="bi bi-building"></i> Edit Brand</h3>
    <a asp-area="Admin"
       asp-controller="Brands"
       asp-action="Index"
       class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Back
    </a>
</div>

<div class="card shadow-sm">
    <div class="card-body p-4">
        <form asp-area="Admin"
              asp-controller="Brands"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="BrandLogo" class="form-label">Brand Logo</label>
                <input asp-for="BrandLogo" class="form-control" type="file" accept="image/*" />
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.LogoUrl))
            {
                <div class="mb-3">
                    <label class="form-label">Current Logo</label>
                    <br />
                    <img src="@Model.LogoUrl"
                         alt="@Model.Name"
                         style="max-width: 180px; max-height: 120px; object-fit: contain;" />
                </div>
            }

            <div class="mb-3">
                <label asp-for="Country" class="form-label"></label>
                <input asp-for="Country" class="form-control" />
                <span asp-validation-for="Country" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WebsiteUrl" class="form-label"></label>
                <input asp-for="WebsiteUrl" class="form-control" />
                <span asp-validation-for="WebsiteUrl" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="IsActive" class="form-check-input" />
                <label asp-for="IsActive" class="form-check-label">Active</label>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check"></i> Save Changes
            </button>

            <a asp-area="Admin"
               asp-controller="Brands"
               asp-action="Index"
               class="btn btn-secondary">
                Cancel
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
